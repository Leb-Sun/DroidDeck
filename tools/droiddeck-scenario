#!/usr/bin/env python3
"""Run a device scenario through droiddeckctl, repeatedly, and report each run.

A scenario is JSON (stdlib only, no YAML):

    {
      "name": "skyrim-focus",
      "vars": {"appId": 489830},
      "repeat": 6,
      "setup":    [["wake"]],
      "before":   [["start", "steam", "--wait", "--reuse", "--timeout", "180"]],
      "steps":    [["launch", "${appId}", "--wait", "--timeout", "240"],
                   {"assert": "session.focus.focusedApp", "equals": "${appId}"},
                   {"screenshot": "in-game"},
                   ["quit", "${appId}"]],
      "after":    [["quit", "${appId}"]],
      "teardown": [["stop"]]
    }

A list step is a droiddeckctl command line; its JSON answer becomes "last". An assert step checks
a dotted path in the last answer ("equals", "in", "contains", "exists", "not"); {"sleep": s},
{"screenshot": "name"} and {"record": "name", "seconds": s} do what they say. ${var} is replaced
from "vars" and --var KEY=VALUE. setup and teardown run once; steps run "repeat" times (or
--repeat), each preceded by "before" (a failure there fails the run) and followed by "after"
whether it passed or not, so a failed run cannot leave a game running into the next and a session
that died in one run is started again for the next. A failing run gets a screenshot, the focus state and the session's logs in
its folder.

    tools/droiddeck-scenario tools/scenarios/steam-game-focus.json --var appId=489830 --out ./runs

--ab KEY=A,B compares two values of a session preference (03-design.md §6.3): the steps run in
A B B A order, --repeat times over, each run after `prefs set session KEY <value>` and --cooldown
seconds (180) after the run before it. The newest performance report is fetched after each run into
its folder (perf-report.json and .txt, waiting a little for the session's teardown time), with
ab.json naming the run's arm; tools/perf-compare reads the output folder.

    tools/droiddeck-scenario tools/scenarios/perf-baseline.json --var appId=489830 --ab gameStateHints=false,true --repeat 3

Exit status: 0 when every run passed, 1 when any failed, 2 for a bad scenario or a failed setup.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
_loader = importlib.machinery.SourceFileLoader("droiddeckctl", str(HERE / "droiddeckctl"))
_spec = importlib.util.spec_from_loader("droiddeckctl", _loader)
ctl = importlib.util.module_from_spec(_spec)
_loader.exec_module(ctl)


class StepFailed(Exception):
    pass


# How long a run's report is waited for once the run is over: its teardown time is written after the
# session has stopped (session.teardown_done).
REPORT_WAIT_S = 30
REPORT_POLL_S = 2
AB_ORDER = "ABBA"


def parse_ab(spec: str, kind: str | None) -> dict:
    """KEY=A,B, with the preference type --ab-type names or the values suggest."""
    key, _, values = spec.partition("=")
    a, _, b = values.partition(",")
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.]*", key) or not a or not b or a == b or "," in b:
        raise ValueError(f"--ab wants KEY=A,B with two different values, not {spec!r}")
    if kind is None:
        if {a, b} <= {"true", "false"}:
            kind = "bool"
        elif all(re.fullmatch(r"-?\d+", v) for v in (a, b)):
            kind = "int"
        else:
            kind = "string"
    return {"key": key, "a": a, "b": b, "type": kind}


def write_text(path: Path, text: str) -> None:
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "w") as stream:
        os.fchmod(stream.fileno(), 0o600)
        stream.write(text)


def write_json(path: Path, value) -> None:
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "w") as stream:
        os.fchmod(stream.fileno(), 0o600)
        json.dump(value, stream, indent=2, sort_keys=True)


def substitute(value, variables: dict):
    if isinstance(value, str):
        whole = re.fullmatch(r"\$\{(\w+)\}", value)
        if whole and whole.group(1) in variables:
            return variables[whole.group(1)]
        return re.sub(r"\$\{(\w+)\}", lambda m: str(variables.get(m.group(1), m.group(0))), value)
    if isinstance(value, list):
        return [substitute(v, variables) for v in value]
    if isinstance(value, dict):
        return {k: substitute(v, variables) for k, v in value.items()}
    return value


def lookup(data, path: str):
    for part in path.split("."):
        if isinstance(data, list) and part.isdigit():
            data = data[int(part)] if int(part) < len(data) else None
        elif isinstance(data, dict):
            data = data.get(part)
        else:
            return None
    return data


def check(step: dict, last: dict) -> None:
    path = step["assert"]
    value = lookup(last, path)
    if "equals" in step and value != step["equals"]:
        raise StepFailed(f"{path} is {value!r}, expected {step['equals']!r}")
    if "not" in step and value == step["not"]:
        raise StepFailed(f"{path} is {value!r}")
    if "in" in step and value not in step["in"]:
        raise StepFailed(f"{path} is {value!r}, expected one of {step['in']!r}")
    if "contains" in step and (not isinstance(value, (list, str)) or step["contains"] not in value):
        raise StepFailed(f"{path} is {value!r}, expected it to contain {step['contains']!r}")
    if step.get("exists") is True and value is None:
        raise StepFailed(f"{path} is missing")


class Runner:
    def __init__(self, adb: str, serial: str, out: Path, global_args: list[str]):
        self.adb = adb
        self.serial = serial
        self.out = out
        self.global_args = global_args
        self.parser = ctl.build_parser()

    def ctl(self, words: list) -> dict:
        args = self.parser.parse_args(self.global_args + [str(w) for w in words])
        try:
            return ctl.execute(args, self.adb, self.serial)
        except ctl.ControlError as exc:
            raise StepFailed(f"droiddeckctl {' '.join(map(str, words))}: {exc.code}: {exc}") from exc

    def run_steps(self, steps: list, folder: Path, log: list) -> None:
        last: dict = {}
        for index, step in enumerate(steps):
            started = time.monotonic()
            entry = {"step": index, "what": step}
            try:
                if isinstance(step, list):
                    last = self.ctl(step)
                    entry["result"] = last
                elif "assert" in step:
                    check(step, last)
                elif "sleep" in step:
                    time.sleep(float(step["sleep"]))
                elif "screenshot" in step:
                    entry["result"] = ctl.screenshot(self.adb, self.serial, str(folder / f"{step['screenshot']}.png"),
                                                     step.get("display"))
                elif "record" in step:
                    entry["result"] = ctl.record(self.adb, self.serial, str(folder / f"{step['record']}.mp4"),
                                                 float(step.get("seconds", 10)), step.get("display"))
                else:
                    raise StepFailed(f"Unknown step {step!r}")
                entry["ok"] = True
            except (StepFailed, ctl.ControlError) as exc:
                entry["ok"] = False
                entry["error"] = str(exc)
                raise StepFailed(f"step {index} {json.dumps(step)}: {exc}") from exc
            finally:
                entry["seconds"] = round(time.monotonic() - started, 2)
                log.append(entry)

    def fetch_report(self, folder: Path, previous: str | None) -> dict:
        """The newest report, into [folder], once it is this run's (not [previous]'s session) and has
        its teardown time, or REPORT_WAIT_S on."""
        deadline = time.monotonic() + REPORT_WAIT_S
        while True:
            answer = self.ctl(["perf"])
            report = answer.get("report") if isinstance(answer.get("report"), dict) else {}
            fresh = answer.get("sessionId") != previous
            done = report.get("schema") != "droiddeck.perf/2" or report.get("teardownMs") is not None
            if (fresh and done) or time.monotonic() >= deadline:
                break
            time.sleep(REPORT_POLL_S)
        if not fresh:
            raise StepFailed(f"no new performance report: the newest is still session {previous}'s")
        write_text(folder / "perf-report.txt", answer.get("summary") or "")
        if report:
            write_json(folder / "perf-report.json", report)
        return {"sessionId": answer.get("sessionId"), "teardownMs": report.get("teardownMs")}

    def evidence(self, folder: Path) -> dict:
        """What a failed run leaves behind: the screen, gamescope's focus, the session's logs."""
        found = {}
        for name, action in (
            ("screenshot", lambda: ctl.screenshot(self.adb, self.serial, str(folder / "failure.png"), None)),
            ("focus", lambda: self.ctl(["focus"])),
            ("logs", lambda: self.ctl(["logs", "latest", str(folder / "session")])),
        ):
            try:
                found[name] = action()
            except Exception as exc:
                found[name] = {"ok": False, "error": str(exc)}
        write_json(folder / "evidence.json", found)
        return {k: v.get("ok", True) if isinstance(v, dict) else True for k, v in found.items()}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("scenario")
    parser.add_argument("--var", action="append", default=[], metavar="KEY=VALUE")
    parser.add_argument("--repeat", type=int)
    parser.add_argument("--out", default="scenario-runs")
    parser.add_argument("--adb")
    parser.add_argument("--serial")
    parser.add_argument("--package", help="the installed build's package (defaults to DROIDDECK_PACKAGE, then the released app)")
    parser.add_argument("--keep-going", action="store_true", help="run every repeat even after a failure")
    parser.add_argument("--ab", metavar="KEY=A,B", help="A/B a session preference: A B B A per repeat (03-design.md §6.3)")
    parser.add_argument("--ab-type", choices=["bool", "int", "string"], help="the preference's type (default: from the values)")
    parser.add_argument("--cooldown", type=float, default=180, metavar="S", help="seconds between --ab runs (default 180)")
    args = parser.parse_args(argv)
    try:
        ab = parse_ab(args.ab, args.ab_type) if args.ab else None
    except ValueError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 2

    try:
        scenario = json.loads(Path(args.scenario).read_text())
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": f"Cannot read scenario: {exc}"}))
        return 2
    variables = dict(scenario.get("vars", {}))
    for item in args.var:
        key, _, value = item.partition("=")
        variables[key] = int(value) if value.lstrip("-").isdigit() else value
    scenario = substitute(scenario, variables)
    repeat = args.repeat or int(scenario.get("repeat", 1))

    adb = ctl.adb_path(args.adb)
    serial = ctl.resolve_serial(adb, args.serial, log=True)
    out = Path(args.out).expanduser().resolve() / f"{scenario.get('name', 'scenario')}-{time.strftime('%Y%m%d-%H%M%S')}"
    out.mkdir(parents=True, exist_ok=True, mode=0o700)
    global_args = (["--adb", adb] if args.adb else []) + ["--serial", serial] + (["--package", args.package] if args.package else [])
    runner = Runner(adb, serial, out, global_args)
    report = {"name": scenario.get("name"), "serial": serial, "vars": variables, "repeat": repeat,
              "out": str(out), "runs": []}
    # Without --ab, each run as it is; with it, an arm and its value per run, A B B A per repeat.
    plan = [(arm, ab[arm.lower()]) for _ in range(repeat) for arm in AB_ORDER] if ab else [(None, None)] * repeat
    if ab:
        report["ab"] = dict(ab, cooldown=args.cooldown, order="".join(arm for arm, _ in plan))

    status = 0
    setup_log: list = []
    previous_session = None
    ended = None
    try:
        runner.run_steps(scenario.get("setup", []), out, setup_log)
        for run, (arm, value) in enumerate(plan, start=1):
            if ended is not None:
                rest = args.cooldown - (time.monotonic() - ended)
                if rest > 0:
                    print(f"cooling down {rest:.0f} s", file=sys.stderr)
                    time.sleep(rest)
            folder = out / f"run-{run:02d}"
            folder.mkdir(mode=0o700)
            log: list = []
            started = time.monotonic()
            result = {"run": run, "folder": str(folder)}
            prefs = [["prefs", "set", "session", ab["key"], value, "--type", ab["type"]]] if ab else []
            try:
                runner.run_steps(prefs + scenario.get("before", []) + scenario.get("steps", []), folder, log)
                result["ok"] = True
            except StepFailed as exc:
                result["ok"] = False
                result["error"] = str(exc)
                result["evidence"] = runner.evidence(folder)
                status = 1
            after: list = []
            try:
                runner.run_steps(scenario.get("after", []), folder, after)
            except StepFailed as exc:
                result["afterError"] = str(exc)
            log.extend({**entry, "after": True} for entry in after)
            if ab:
                result["ab"] = {"key": ab["key"], "value": value, "arm": arm, "a": ab["a"], "b": ab["b"]}
                try:
                    fetched = runner.fetch_report(folder, previous_session)
                    previous_session = fetched["sessionId"]
                    result["report"] = fetched
                except StepFailed as exc:
                    result["ok"] = False
                    result["error"] = result.get("error") or str(exc)
                    status = 1
                write_json(folder / "ab.json", dict(result["ab"], ok=result["ok"]))
                ended = time.monotonic()
            result["seconds"] = round(time.monotonic() - started, 2)
            write_json(folder / "steps.json", log)
            report["runs"].append(result)
            label = f"run {run}/{len(plan)}" + (f" ({arm}: {ab['key']}={value})" if ab else "")
            print(f"{label}: {'PASS' if result['ok'] else 'FAIL ' + result['error']}", file=sys.stderr)
            if not result["ok"] and not args.keep_going:
                break
    except StepFailed as exc:
        report["setupError"] = str(exc)
        status = 2
    finally:
        teardown_log: list = []
        try:
            runner.run_steps(scenario.get("teardown", []), out, teardown_log)
        except StepFailed as exc:
            report["teardownError"] = str(exc)
        write_json(out / "setup.json", setup_log + teardown_log)

    passed = sum(1 for r in report["runs"] if r["ok"])
    report.update({"ok": status == 0, "passed": passed, "failed": len(report["runs"]) - passed})
    write_json(out / "report.json", report)
    print(json.dumps(report, indent=2, sort_keys=True))
    return status


if __name__ == "__main__":
    raise SystemExit(main())
