From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DroidDeck <droiddeck@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] linux: BL_NATIVE_BLOCK gate for Android-blocked syscalls;
 setfsuid and setfsgid without the syscall

Android's app seccomp filter answers a fixed set of syscalls with SIGSYS,
and with no tracer that SIGSYS kills the process. A few of them are blocked
only on some releases (clone3 before Android 15, faccessat2 and fchmodat2
before 16 QPR1), so glibc cannot know at build time whether issuing them is
safe. The app probes the device's filter at session start and passes the
answer as BL_NATIVE_BLOCK, a hex mask read once into a hidden cache that
__bl_blocked () tests. Unset or unreadable means every gated call is
blocked, the worst case, which only ever costs a portable fallback. Later
patches put the gate in front of each call.

setfsuid and setfsgid are blocked on every release and have no replacement.
They return the current effective id, which is what the fsuid of a process
that cannot change its ids always is.
---
 sysdeps/unix/sysv/linux/Makefile     |  1 +
 sysdeps/unix/sysv/linux/bl-seccomp.c | 34 +++++++++++++++++++
 sysdeps/unix/sysv/linux/bl-seccomp.h | 50 ++++++++++++++++++++++++++++
 sysdeps/unix/sysv/linux/setfsgid.c   | 12 +++++++
 sysdeps/unix/sysv/linux/setfsuid.c   | 18 ++++++++++
 5 files changed, 115 insertions(+)
 create mode 100644 sysdeps/unix/sysv/linux/bl-seccomp.c
 create mode 100644 sysdeps/unix/sysv/linux/bl-seccomp.h
 create mode 100644 sysdeps/unix/sysv/linux/setfsgid.c
 create mode 100644 sysdeps/unix/sysv/linux/setfsuid.c

diff --git a/sysdeps/unix/sysv/linux/Makefile b/sysdeps/unix/sysv/linux/Makefile
index c6bd97ab..1ed7e136 100644
--- a/sysdeps/unix/sysv/linux/Makefile
+++ b/sysdeps/unix/sysv/linux/Makefile
@@ -59,6 +59,7 @@ endif
 ifeq ($(subdir),misc)
 sysdep_routines += \
   adjtimex \
+  bl-seccomp \
   clock_adjtime \
   clone \
   clone-internal \
diff --git a/sysdeps/unix/sysv/linux/bl-seccomp.c b/sysdeps/unix/sysv/linux/bl-seccomp.c
new file mode 100644
index 00000000..dea2a8e1
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/bl-seccomp.c
@@ -0,0 +1,34 @@
+/* DroidDeck native mode: runtime gate for Android-blocked syscalls.
+   See bl-seccomp.h.  */
+
+#include <bl-seccomp.h>
+#include <stdlib.h>
+
+/* -1 => not initialised yet; __bl_blocked() then takes the safe default.  */
+int __bl_block_mask_cache = -1;
+
+void
+__bl_block_mask_init (void)
+{
+  int m = BL_BLK_DEFAULT;
+  const char *s = getenv ("BL_NATIVE_BLOCK");
+  if (s != NULL && *s != '\0')
+    {
+      /* Hex mask; "0" explicitly means "nothing blocked" (Android 16 QPR1+
+         with clone3/faccessat2/fchmodat2 all allowed).  */
+      char *end;
+      long v = strtol (s, &end, 16);
+      if (end != s)
+	m = (int) v;
+    }
+  __bl_block_mask_cache = m;
+}
+
+/* Fill the cache before user main() where possible.  A late constructor is
+   fine: the version-gated syscalls (clone3 at the first pthread_create,
+   faccessat2/fchmodat2 at the first such call) are all issued after ctors.  */
+static void __attribute__ ((constructor))
+__bl_block_mask_ctor (void)
+{
+  __bl_block_mask_init ();
+}
diff --git a/sysdeps/unix/sysv/linux/bl-seccomp.h b/sysdeps/unix/sysv/linux/bl-seccomp.h
new file mode 100644
index 00000000..5905a3de
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/bl-seccomp.h
@@ -0,0 +1,50 @@
+/* DroidDeck native mode: runtime gate for Android-blocked syscalls.
+
+   Android's app seccomp policy answers a fixed set of syscalls with SIGSYS.
+   Without a tracer that SIGSYS kills the process.  A few of the blocked
+   syscalls are *version dependent* (clone3 before Android 15; faccessat2,
+   fchmodat2 before Android 16 QPR1), so glibc cannot decide statically
+   whether issuing them is safe.  The app knows the device's Android version
+   (and runs a forked-child seccomp probe at session start, 02 S9.1), so it
+   passes the result in the environment.
+
+   BL_NATIVE_BLOCK is a hex mask of syscalls that MUST NOT be issued because
+   this device's filter traps them.  When unset the mask defaults to
+   BL_BLK_DEFAULT (all version-gated syscalls assumed blocked = the Android 14
+   worst case), which is always safe: glibc just uses the portable fallback.
+
+   rseq and set_robust_list are blocked on *every* Android 10-17, so they are
+   skipped unconditionally elsewhere and are not represented here.
+
+   DroidDeck builds this into the rootfs's glibc (tools/glibc in its tree)
+   and stages it per session, behind the patchedGlibc toggle.  */
+
+#ifndef _BL_SECCOMP_H
+#define _BL_SECCOMP_H 1
+
+#define BL_BLK_CLONE3     0x1
+#define BL_BLK_FACCESSAT2 0x2
+#define BL_BLK_FCHMODAT2  0x4
+#define BL_BLK_DEFAULT    (BL_BLK_CLONE3 | BL_BLK_FACCESSAT2 | BL_BLK_FCHMODAT2)
+
+/* The cached mask, defined in bl-seccomp.c.  Filled by an ELF constructor and,
+   defensively, lazily on first query.  Before either runs it reads as
+   BL_BLK_DEFAULT (the -1 sentinel maps to the safe default), so a very early
+   caller never issues a version-gated syscall.  */
+extern int __bl_block_mask_cache attribute_hidden;
+
+extern void __bl_block_mask_init (void) attribute_hidden;
+
+static inline int
+__bl_blocked (int bit)
+{
+  int m = __bl_block_mask_cache;
+  if (__glibc_unlikely (m < 0))
+    {
+      __bl_block_mask_init ();
+      m = __bl_block_mask_cache;
+    }
+  return (m & bit) != 0;
+}
+
+#endif /* bl-seccomp.h */
diff --git a/sysdeps/unix/sysv/linux/setfsgid.c b/sysdeps/unix/sysv/linux/setfsgid.c
new file mode 100644
index 00000000..16cdedc0
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/setfsgid.c
@@ -0,0 +1,12 @@
+/* DroidDeck native mode: setfsgid without the blocked syscall.
+   See setfsuid.c.  */
+
+#include <sys/fsuid.h>
+#include <unistd.h>
+
+int
+setfsgid (gid_t gid)
+{
+  (void) gid;
+  return (int) __getegid ();
+}
diff --git a/sysdeps/unix/sysv/linux/setfsuid.c b/sysdeps/unix/sysv/linux/setfsuid.c
new file mode 100644
index 00000000..d3f8a981
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/setfsuid.c
@@ -0,0 +1,18 @@
+/* DroidDeck native mode: setfsuid without the blocked syscall.
+
+   Android's app seccomp policy SIGSYS-blocks setfsuid/setfsuid32 and offers no
+   replacement.  The fsuid always tracks the effective uid for a non-root app
+   that cannot change it, and setfsuid(2) never fails: it returns the previous
+   fsuid.  Return the current effective uid without issuing the syscall.
+
+   This overrides the stub that syscalls.list would otherwise generate.  */
+
+#include <sys/fsuid.h>
+#include <unistd.h>
+
+int
+setfsuid (uid_t uid)
+{
+  (void) uid;
+  return (int) __geteuid ();
+}
