From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DroidDeck <droiddeck@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH] linux: faccessat2 and fchmodat2 take the portable fallback
 when blocked

The filter traps both before Android 16 QPR1. With bit 0x2 (faccessat2) or
0x4 (fchmodat2) set, the call behaves as if the kernel had answered ENOSYS
and glibc's existing fallback runs instead. The fallback is compiled in
because the minimum kernel leaves __ASSUME_FACCESSAT2 and
__ASSUME_FCHMODAT2 at 0; tools/glibc/build-in-arch.sh checks both.
---
 sysdeps/unix/sysv/linux/faccessat.c | 15 ++++++++++++++-
 sysdeps/unix/sysv/linux/fchmodat.c  |  7 +++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/sysdeps/unix/sysv/linux/faccessat.c b/sysdeps/unix/sysv/linux/faccessat.c
index 97efb740..2f40b0bd 100644
--- a/sysdeps/unix/sysv/linux/faccessat.c
+++ b/sysdeps/unix/sysv/linux/faccessat.c
@@ -21,12 +21,25 @@
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sysdep.h>
+#include <bl-seccomp.h>		/* DroidDeck native mode.  */
 
 
 int
 __faccessat (int fd, const char *file, int mode, int flag)
 {
-  int ret = INLINE_SYSCALL_CALL (faccessat2, fd, file, mode, flag);
+  /* DroidDeck native mode: faccessat2 is SIGSYS-blocked before Android
+     16 QPR1.  When the app marks it blocked, behave exactly as if the kernel
+     returned ENOSYS (set errno and ret), so we take the portable fallback
+     below without ever issuing the syscall.  On 16 QPR1+ the bit is clear and
+     the fast single syscall runs.  */
+  int ret;
+  if (__bl_blocked (BL_BLK_FACCESSAT2))
+    {
+      __set_errno (ENOSYS);
+      ret = -1;
+    }
+  else
+    ret = INLINE_SYSCALL_CALL (faccessat2, fd, file, mode, flag);
 #if __ASSUME_FACCESSAT2
   return ret;
 #else
diff --git a/sysdeps/unix/sysv/linux/fchmodat.c b/sysdeps/unix/sysv/linux/fchmodat.c
index 85d61544..474f583b 100644
--- a/sysdeps/unix/sysv/linux/fchmodat.c
+++ b/sysdeps/unix/sysv/linux/fchmodat.c
@@ -25,6 +25,7 @@
 #include <sys/types.h>
 #include <sysdep.h>
 #include <unistd.h>
+#include <bl-seccomp.h>		/* DroidDeck native mode.  */
 
 #if !__ASSUME_FCHMODAT2
 static int
@@ -96,6 +97,12 @@ fchmodat (int fd, const char *file, mode_t mode, int flag)
   if (flag == 0)
     return INLINE_SYSCALL_CALL (fchmodat, fd, file, mode);
 
+  /* DroidDeck native mode: fchmodat2 is SIGSYS-blocked before Android
+     16 QPR1.  When the app marks it blocked, go straight to the O_PATH + /proc
+     fallback instead of issuing the trapping syscall.  */
+  if (__bl_blocked (BL_BLK_FCHMODAT2))
+    return fchmodat_fallback (fd, file, mode, flag);
+
   int r = INLINE_SYSCALL_CALL (fchmodat2, fd, file, mode, flag);
   if (r != 0 && errno == ENOSYS)
     return fchmodat_fallback (fd, file, mode, flag);
