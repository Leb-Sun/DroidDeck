# The glibc overlay the apk carries (assets/linuxfs/glibc/<version>/): a release that
# build-glibc.yml published on GLIBC_REPO, pinned by the sha256 of each asset. Its run's summary
# prints these lines ready to paste. With no tag the apk builds without the overlay, and turning on
# Performance > Patched glibc stages nothing (the state file says mismatch).
GLIBC_REPO=Leb-Sun/DroidDeck
GLIBC_TAG=
GLIBC_MANIFEST_SHA256=
GLIBC_REBUILD_SHA256=
GLIBC_PATCHED_SHA256=
