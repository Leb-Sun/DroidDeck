# The rootfs's own glibc, which build-in-arch.sh rebuilds and the app stages over the stock files
# per session (session/NativeGlibc.kt, docs/development/native-env/03-design.md §4.2-4.4): Arch
# Linux ARM's package of the version the runtime image ships (tools/desktop-kde/runtime-packages.txt),
# pinned by the commit in its version string.
GLIBC_PKGVER=2.43+r22+g8362e8ce10b2
GLIBC_PKGREL=2
GLIBC_BRANCH=release/2.43/master
GLIBC_COMMIT=8362e8ce10b24068bacc19552c128dd10e082fd9
# Where that commit is fetched from: the PKGBUILD's own source first, then mirrors of it. The commit
# id pins the tree whichever one answers.
GLIBC_GIT=https://sourceware.org/git/glibc.git
GLIBC_GIT_MIRRORS="https://forge.sourceware.org/glibc/glibc-mirror.git https://github.com/kraj/glibc.git"
# Arch Linux ARM's PKGBUILD at the commit that published this pkgrel (core/glibc): the configure
# flags, the toolchain flags and its own prepare() patches are its, not ours.
ALARM_PKGBUILDS=https://github.com/archlinuxarm/PKGBUILDs
ALARM_PKGBUILDS_COMMIT=f3d82dd0cd144ea3aa9ca036679c10c7732e8760
# The stock package as devices have it: inside the runtime image the catalog serves (linuxfs-r9).
# Arch Linux ARM keeps no archive of superseded packages, so this is where its files are taken from.
STOCK_ROOTFS_URL=https://github.com/Droid-Deck/DroidDeck-Components/releases/download/linuxfs-r9/linuxfs.tar.zst
STOCK_ROOTFS_SHA256=d3240c1531531615b0dd06b6ad56e92db9015a8641eb18c3a613835ae45992e7
# sha256 of every ELF shared object and executable (ET_DYN) the stock package owns: the overlay's
# file set, and what a rootfs must hold before anything is staged over it. Each matches the
# package's own mtree. The crt*.o and libmcheck.a objects are link-time only and stay stock.
# Refresh, for a new version: build-in-arch.sh derives the list from STOCK_ROOTFS_URL and prints it
# when it differs from this one; or, from an unpacked rootfs,
#   python3 tools/glibc/manifest.py stock-list ROOT ROOT/var/lib/pacman/local/glibc-<pkgver>-<pkgrel>
