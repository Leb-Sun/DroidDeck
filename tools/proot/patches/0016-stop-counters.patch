 src/syscall/syscall.c |   3 +
 src/tracee/event.c    |  45 ++++++++---
 src/tracee/seccomp.c  |   2 +
 src/tracee/stats.c    | 202 ++++++++++++++++++++++++++++++++++++++++++++++++++
 src/tracee/stats.h    |  71 ++++++++++++++++++
 6 files changed, 313 insertions(+), 11 deletions(-)

